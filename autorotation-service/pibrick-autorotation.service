[Unit]
Description=piBrick MMA8451Q Autorotation Service
After=graphical.target multi-user.target
Wants=graphical.target

# Prefer to run when a display session is active
After=display-manager.service

[Service]
Type=simple
ExecStart=/usr/lib/pibrick/autorotation-service/pibrick-autorotation.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Run as the desktop user so kscreen-doctor has access to the Wayland session
# without needing sudo/su.
User=congn
Group=congn

# Environment variables — needed for kscreen-doctor to connect to the Wayland
# compositor and the D-Bus session bus.  These are set explicitly here since
# systemd's ImportEnvironment= is not available on this version.
Environment=USER=congn
Environment=HOME=/home/congn
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=QT_QPA_PLATFORM=wayland
Environment=EGL_PLATFORM=wayland
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# Hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pibrick
# NOTE: PrivateTmp is intentionally NOT set — kscreen-doctor needs to access the
# Wayland socket at /run/user/1000 which is blocked in an isolated /tmp.

# Allow access to IIO accelerometer sysfs (world-readable) and i2c bus
DevicePolicy=auto
DeviceAllow=/sys/bus/iio/devices/iio:device* r
DeviceAllow=/dev/i2c-* rw

# Grant access to the video group (for kscreen-doctor / DRM)
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
