# bash completion for pibrick-tools
# Generated by install.sh; installed to /etc/bash_completion.d/pibrick-tools
# (or /usr/share/bash-completion/completions/pibrick-tools).

_pibrick_tools() {
	local cur prev opts_general opts_install opts_calib opts_battery
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"

	# Top-level options
	opts_general=(
		"--help" "--version"
		"--install" "--uninstall"
		"--enable-calibration" "--disable-calibration"
		"--reset-calibration"
		"--status-calibration" "--apply-calibration"
		"--battery-status" "--battery-config"
		"--enable-upower" "--disable-upower"
	)

	# Components you can pass to --install
	opts_install=(
		"all" "display" "display-new" "display-old"
		"battery" "battery-new" "battery-original"
		"calibration" "upower" "button"
	)

	# Sub-params you can pass to --battery-config <param>
	opts_battery=(
		"charge_full_uah" "ina228_shunt_uohm" "ina228_max_current_ua"
		"discharge_current_ua" "batt_ir_mohm" "discharge_avg_ua"
		"discharge_load_factor_pct" "discharge_max_ua"
		"rest_min_sec" "low_v_persistent_count"
		"coulomb_uah" "--show" "--list" "--persist"
	)

	case "$prev" in
		--install)
			COMPREPLY=( $(compgen -W "${opts_install[*]}" -- "$cur") )
			return 0
			;;
		--battery-config)
			COMPREPLY=( $(compgen -W "${opts_battery[*]}" -- "$cur") )
			return 0
			;;
		*)
			COMPREPLY=( $(compgen -W "${opts_general[*]}" -- "$cur") )
			return 0
			;;
	esac
}

complete -F _pibrick_tools pibrick-tools
