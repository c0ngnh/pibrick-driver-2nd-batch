[Unit]
Description=piBrick Battery Calibration Logger
After=local-fs.target
RequiresMountsFor=/sys/class/power_supply/battery

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'if [ ! -d /sys/class/power_supply/battery ]; then echo "Battery sysfs not found. Waiting..."; for i in $(seq 1 30); do [ -d /sys/class/power_supply/battery ] && exit 0; sleep 1; done; [ -d /sys/class/power_supply/battery ] || exit 1; fi'
ExecStart=/usr/bin/python3 __PIBRICK_TOOLS__/battery-calibration-logger.py --interval 10
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
User=root
SyslogIdentifier=battery-calibration

[Install]
WantedBy=multi-user.target
