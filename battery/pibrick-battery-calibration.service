[Unit]
Description=piBrick Battery Calibration Logger
After=network.target

[Service]
Type=simple
# Path substituted at install time by install.sh.
# Default install location: $PIBRICK_USER_HOME/battery-tools/
ExecStart=/usr/bin/python3 __PIBRICK_TOOLS__/battery-calibration-logger.py --interval 10
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
User=root

# Logging to /var/log/bq25890_battery/calibration.log
SyslogIdentifier=battery-calibration

[Install]
WantedBy=multi-user.target
